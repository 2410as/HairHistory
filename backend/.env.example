PORT=8080

# Must match the port published by docker-compose (POSTGRES_PORT).
DATABASE_URL=postgres://hairhistory:hairhistory@localhost:5432/hairhistory?sslmode=disable

# Required only when APP_ENV=production.
GOOGLE_CLIENT_ID=

# Comma separated. "*" is rejected because the session cookie needs credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

SESSION_TTL_HOURS=720

# development enables POST /api/auth/dev-login and sends a non-Secure cookie.
APP_ENV=development
