# HairHistory API environment.
#
# Install to /etc/hairhistory/api.env and lock it down - it holds the DB password:
#   sudo install -d -m 0755 /etc/hairhistory
#   sudo cp deploy/api.env.example /etc/hairhistory/api.env
#   sudo chown root:root /etc/hairhistory/api.env
#   sudo chmod 600 /etc/hairhistory/api.env
#   sudo nano /etc/hairhistory/api.env
#
# systemd parses this file itself: KEY=value, no `export`, no shell expansion,
# and no quotes unless the quotes are part of the value.

# ############################################################################
# # APP_ENV=production IS A SECURITY CONTROL - DO NOT REMOVE OR CHANGE IT.   #
# #                                                                          #
# # With anything other than "production", the backend registers the         #
# # development bypass route POST /api/auth/dev-login, which mints a valid   #
# # session for ANY email address with no Google verification. Leaving it    #
# # enabled on a public server means anyone can log in as anyone.            #
# #                                                                          #
# # APP_ENV=production also sets Secure on the session cookie.               #
# ############################################################################
APP_ENV=production

# Port the Go API listens on. nginx proxies /api/ to 127.0.0.1:<PORT>.
# Keep this closed at the firewall; it is never reached from the internet directly.
PORT=8080

# PostgreSQL runs on this same host, so the connection never leaves the machine
# and sslmode=disable is acceptable. URL-encode @ : / ? # % in the password.
DATABASE_URL=postgres://hairhistory:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/hairhistory?sslmode=disable

# Google OAuth 2.0 Web client ID (ends in .apps.googleusercontent.com).
# REQUIRED when APP_ENV=production - the server refuses to start without it.
# There is no client secret here: the app verifies Google ID tokens client-side-issued.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Comma-separated exact origins. "*" is rejected because credentials are enabled.
# Must be the scheme+host users actually browse to, with no trailing slash.
# Switch to https://... at the same time you enable TLS.
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_YOUR_DOMAIN_OR_EC2_PUBLIC_DNS

# Session lifetime in hours (positive integer). Default when unset: 720 (30 days).
SESSION_TTL_HOURS=720
